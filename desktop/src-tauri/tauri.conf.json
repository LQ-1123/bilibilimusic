{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BiliMusic",
  "version": "0.2.1",
  "identifier": "io.github.lq1123.bilimusic",
  "build": { "frontendDist": "../ui" },
  "app": {
    "windows": [],
    "withGlobalTauri": true,
    "security": { "capabilities": ["main"], "csp": "default-src 'self' http://127.0.0.1:*; connect-src 'self' http://127.0.0.1:*; img-src 'self' data: https: http://127.0.0.1:*; style-src 'self' 'unsafe-inline'" }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "nsis"],
    "category": "Music",
    "shortDescription": "A personal Bilibili music player",
    "icon": ["icons/icon.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": { "../backend/bilimusic-backend/": "backend/" },
    "macOS": { "minimumSystemVersion": "14.0" },
    "windows": {
      "webviewInstallMode": { "type": "offlineInstaller", "silent": true },
      "nsis": { "installMode": "currentUser", "displayLanguageSelector": true, "languages": ["SimpChinese", "English"] }
    }
  }
}
